    {
      "name": "list_project_issues",
      "description": "Read issues from one authorized project. Project paths are URL-encoded as one segment.",
      "method": "GET",
      "path": "/projects/{project_id}/issues",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Identifier"
          },
          "state": {
            "type": "string",
            "enum": [
              "opened",
              "closed",
              "all"
            ]
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "project_id"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "project_id"
        ],
        "query": {
          "state": "state",
          "per_page": "per_page",
          "page": "page"
        },
        "body": {}
      },
      "sampleArguments": {
        "project_id": "group/project",
        "per_page": 10
      },
      "provenance": [
        "https://docs.gitlab.com/api/issues/"
      ],
      "pagination": {
        "type": "header",
        "cursorInput": "page",
        "headerName": "x-next-page"
      }
    }
  ],
  "workflow": {
    "name": "GitLab sprint triage",
